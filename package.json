{
  "name": "raidas-garden",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prepare-dist.js",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "test:smoke": "playwright test e2e/smoke.spec.ts --project=chromium",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:diagnostics": "node scripts/run-diagnostics.js",
    "test:ui": "vitest --ui",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:pull": "prisma db pull",
    "db:seed": "node scripts/seed-supabase.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.0",
    "@hookform/resolvers": "^4.0.0",
    "@legendapp/state": "^2.1.15",
    "@orama/orama": "^3.1.18",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dexie": "^4.3.0",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.3.0",
    "i18next": "^24.2.2",
    "lucide-react": "^0.454.0",
    "motion": "^12.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^15.4.1",
    "react-is": "^19.2.5",
    "recharts": "^3.7.0",
    "rxdb": "^17.2.0",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^3.4.0",
    "xstate": "^5.18.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "4.1.6",
    "autoprefixer": "^10.4.20",
    "connect-history-api-fallback": "^2.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "express": "^5.2.1",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "package-json-type": "^1.1.2",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react>minimatch": "3.1.4",
      "fast-uri": "3.1.2",
      "firebase": "npm:empty-module@0.0.2",
      "flatted": "3.4.2",
      "minimatch@3.1.4>brace-expansion": "1.1.13",
      "minimatch@10.2.5>brace-expansion": "5.0.6",
      "serialize-javascript": "7.0.5",
      "ws": "8.20.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ],
      "allowedVersions": {
        "recharts>react": "19",
        "recharts>react-dom": "19"
      }
    }
  }
}
