# LovelyGarden Environment Variables
# Copy this file to .env and adjust values as needed

# Weather API Configuration
# VITE_WEATHER_API_URL=https://api.open-meteo.com/v1

# API Endpoints (for future features)
# VITE_API_URL=http://localhost:3000

# Supabase browser client (safe for Vercel frontend when RLS is enabled)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Supabase / Prisma Database
# DATABASE_URL is the pooled app connection.
# DIRECT_URL is used by Prisma migrations.
# Replace [YOUR-PASSWORD] locally. Never commit real credentials.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Feature Flags
# VITE_ENABLE_PWA=true
# VITE_ENABLE_ANALYTICS=false

# Debug Settings
# VITE_DEBUG=false
